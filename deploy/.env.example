# dev 서버의 /home/ubuntu/config/.env 에 둘 변수 목록 (권한 600, 배포 폴더 밖)
# 값은 레포·Notion·Jira에 적지 않는다. DB_URL·REDIS_HOST·프로필은 deploy/compose.yaml이 정한다
DB_USERNAME=highfive
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 서비스 JWT 서명 키 (Base64, 32바이트 이상). 없으면 서버가 시작되지 않는다
# 만들기: openssl rand -base64 32
JWT_SECRET=

# 소셜 로그인 ID 토큰의 aud 값. 비어 있는 소셜은 로그인할 수 없다 (AUTH_006). 여러 개면 쉼표로 구분
# 카카오: 네이티브 앱 키(Default, Dev) / 구글: 서버용(웹) 클라이언트 ID / 애플: iOS 번들 ID
OIDC_KAKAO_AUDIENCE=
OIDC_GOOGLE_AUDIENCE=
OIDC_APPLE_AUDIENCE=
