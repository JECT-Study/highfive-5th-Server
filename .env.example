# 로컬 실행용 환경변수. 이 파일을 .env로 복사해서 쓴다 (.env는 커밋하지 않는다)
# compose.yaml과 Spring(local 프로필)이 같은 .env를 읽는다
# Docker로 띄우면 그대로 써도 되고, MySQL을 직접 설치했다면 자기 계정·포트로 바꾼다

DB_PORT=3306
DB_USERNAME=highfive
DB_PASSWORD=highfive

# Docker MySQL의 root 비밀번호 (compose에서만 사용)
MYSQL_ROOT_PASSWORD=root

REDIS_PORT=6379

# JWT 서명 키 (Base64, 32바이트 이상). 비워 두면 local 프로필의 로컬 전용 키를 쓴다
# 만들기: openssl rand -base64 32
# JWT_SECRET=

# 소셜 로그인 ID 토큰의 aud 값. 비어 있는 소셜은 로그인할 수 없다 (AUTH_006). 여러 개면 쉼표로 구분
# 카카오: 네이티브 앱 키(Default, Dev) / 구글: 서버용(웹) 클라이언트 ID / 애플: iOS 번들 ID
# OIDC_KAKAO_AUDIENCE=
# OIDC_GOOGLE_AUDIENCE=
# OIDC_APPLE_AUDIENCE=
